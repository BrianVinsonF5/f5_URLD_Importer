# ============================================================
# bigip-urldb-sync — example environment configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# BIG-IP connection settings
# ------------------------------------------------------------

# Management IP or hostname of the F5 BIG-IP device
BIGIP_HOST=192.0.2.1

# BIG-IP username (default: admin)
BIGIP_USER=admin

# BIG-IP password — NEVER commit the real value to source control
BIGIP_PASSWORD=changeme

# BIG-IP partition (default: Common)
BIGIP_PARTITION=Common

# Set to true to validate the BIG-IP management TLS certificate.
# Leave false when using the default self-signed cert (logs a warning).
# Set to true (or a CA bundle path) in production / federal environments.
BIGIP_VERIFY_SSL=false

# ------------------------------------------------------------
# URLDB category settings
# ------------------------------------------------------------

# Name of the URLDB category object to create or update on BIG-IP
URLDB_CATEGORY=custom_block_list

# Default URL match type applied to entries that do not specify their own type.
# Allowed values: exact | glob | any
URLDB_URL_TYPE=exact

# Maximum number of URLs per URLDB category object.
# Lists exceeding this limit are split into numbered sub-categories (_01, _02 …).
# F5 recommended maximum is 9000.
URLDB_CHUNK_SIZE=9000

# ------------------------------------------------------------
# JSON source
# ------------------------------------------------------------

# Local file path or HTTP/HTTPS URL to the JSON URL list.
# Can be overridden at runtime with the --source CLI flag.
# JSON_SOURCE=/etc/urldb-sync/urls.json
# JSON_SOURCE=https://feeds.example.com/urldb/urls.json

# ------------------------------------------------------------
# Status file
# ------------------------------------------------------------

# Path where the last-run status JSON is written after every sync attempt.
STATUS_FILE_PATH=/var/log/urldb-sync/status.json

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
